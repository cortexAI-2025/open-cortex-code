# Lancement Web local uniquement. Aucune clé API fournisseur dans ce fichier.
CORTEX_PORT=4000
CORTEX_HOST=127.0.0.1
# Le répertoire de données est local et exclu de Git.
# CORTEX_DATA_DIR=/chemin/prive/open-cortex
# Facultatif : origine Web distante explicitement autorisée (HTTPS/PNA peuvent bloquer).
# CORTEX_ALLOWED_ORIGINS=https://votre-interface.example

# Équipe IA : CTO IA d'AiWorkPay (serveur à serveur, jamais dans le navigateur).
# CORTEX_CTO_URL=http://127.0.0.1:3000
# CORTEX_CTO_TOKEN=            # = CTO_ADMIN_TOKEN du CTO (24+ caractères)
